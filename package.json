{
  "name": "faux-raccord",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env scripts/dev.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "eval": "node --env-file-if-exists=.env eval/run.mjs",
    "eval:live": "node --env-file-if-exists=.env eval/run.mjs --live",
    "data:fetch": "python scripts/fetch_corpus.py"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "vite": "8.3.5"
  }
}
